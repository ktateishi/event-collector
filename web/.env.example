# Task 3以降でNext.jsアプリをセットアップした際に .env.local としてコピーし、
# 実際の値を入れてください（.env.local は .gitignore 済みでコミットされません）。
#
# 値の入手先: Supabaseダッシュボード > Project Settings > API

# Supabase プロジェクトURL（例: https://xxxxx.supabase.co）
SUPABASE_URL=

# サーバー側APIルート専用。RLSをバイパスするため、絶対にブラウザに露出させない
# （NEXT_PUBLIC_ プレフィックスを付けないこと）
SUPABASE_SERVICE_ROLE_KEY=

# /api/ingest を外部から叩く場合に使う内部トークン（任意機能。現状Vercel Cronからは
# 直接関数呼び出しのため必須ではない）。ベンダーの実キーではなく自分で生成する
# ランダム文字列でよい（例: openssl rand -hex 32）
INTERNAL_INGEST_TOKEN=

# Vercel Cron が /api/cron/collect を呼ぶ際の認証（Vercelが自動的にこの値を
# Authorization: Bearer ヘッダに付与する）。自分で生成するランダム文字列でよい
CRON_SECRET=

# Task 5: 収集ロジック（GCP Vertex AI, Gemini + Google検索グラウンディング）
# GCPコンソール > IAMと管理 > サービスアカウント で作成し、Vertex AI User権限を付与する
GCP_PROJECT_ID=
GCP_LOCATION=
GEMINI_MODEL=
# サービスアカウントキー(JSON)を1行の文字列にしたもの
GCP_SERVICE_ACCOUNT_KEY=

# Task 8以降で使用
LINE_CHANNEL_ACCESS_TOKEN=

# Task 14以降で使用
X_API_KEY=
X_API_SECRET=

# Task 15以降で使用
INSTAGRAM_ACCESS_TOKEN=

# YouTube検索プロキシ(/api/search/youtube)で使用（任意機能）
YOUTUBE_API_KEY=
