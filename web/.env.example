# Task 3以降でNext.jsアプリをセットアップした際に .env.local としてコピーし、
# 実際の値を入れてください（.env.local は .gitignore 済みでコミットされません）。
#
# 値の入手先: Supabaseダッシュボード > Project Settings > API

# Supabase プロジェクトURL（例: https://xxxxx.supabase.co）
SUPABASE_URL=

# サーバー側APIルート専用。RLSをバイパスするため、絶対にブラウザに露出させない
# （NEXT_PUBLIC_ プレフィックスを付けないこと）
SUPABASE_SERVICE_ROLE_KEY=

# 収集ルーチン(RemoteTrigger)が /api/ingest を叩く際に使う内部トークン。
# ベンダーの実キーではなく自分で生成するランダム文字列でよい
# （例: openssl rand -hex 32）
INTERNAL_INGEST_TOKEN=

# Task 8以降で使用
LINE_CHANNEL_ACCESS_TOKEN=

# Task 14以降で使用
X_API_KEY=
X_API_SECRET=

# Task 15以降で使用
INSTAGRAM_ACCESS_TOKEN=

# Task 5/14以降で使用（収集ルーチンがVercel経由で叩く場合はここに集約）
YOUTUBE_API_KEY=
